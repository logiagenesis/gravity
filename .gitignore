# Generated from data/sources/snapshots/ by scripts/pipeline/build-exoplanets.ts
# in ~1.6s on every build. 4,432 files / 18 MB of derived data does not belong
# in git; the 552 kB snapshot it is derived from does.
data/scenarios/exoplanets

# Generated from data/sources/snapshots/jpl-horizons-state-vectors.csv by
# scripts/pipeline/build-horizons.ts.
data/scenarios/horizons

# Generated from data/sources/snapshots/debcat-debs.dat by
# scripts/pipeline/build-binaries.ts.
data/scenarios/binaries

# Generated by scripts/build-catalog.ts on every build: the catalogue manifest,
# its detail shards, and one JSON file per scenario, served as static assets.
public/catalog
public/scenarios
