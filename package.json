{
  "name": "gravity-simulator",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Interactive n-body gravity simulator with verifiable physics.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run data:build && npm run typecheck && vite build && npm run sitemap",
    "preview": "vite preview --port 4173 --host 127.0.0.1 --strictPort",
    "data:build": "tsx scripts/pipeline/build-exoplanets.ts && tsx scripts/pipeline/build-horizons.ts && tsx scripts/build-catalog.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "licences": "tsx scripts/check-licences.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "verify": "npm run data:build && npm run format:check && npm run lint && npm run typecheck && npm run licences && npm run test && npm run build && npm run e2e",
    "sitemap": "tsx scripts/build-sitemap.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.169.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
